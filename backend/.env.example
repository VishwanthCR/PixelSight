# Copernicus Data Space Ecosystem / Sentinel Hub Credentials (Backend Only)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Processing & Hardware Configuration
PIXELSIGHT_LDSR_BATCH_SIZE=1
PIXELSIGHT_TEST_MODE=0

# AOI Area Limits (in km²)
PIXELSIGHT_AOI_MAX_AREA_SQKM=100.0
PIXELSIGHT_AOI_INTERACTIVE_MAX_SQKM=25.0

# Local PixelSight Analyst (Ollama)
PIXELSIGHT_LLM_PROVIDER=ollama
PIXELSIGHT_OLLAMA_BASE_URL=http://localhost:11434
PIXELSIGHT_OLLAMA_MODEL=qwen2.5:7b
PIXELSIGHT_OLLAMA_TIMEOUT=60.0


